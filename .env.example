# Copy this file to .env and fill in your values. Never commit .env.

# MySQL connection string, used by Drizzle (pnpm db:push) and the app
DATABASE_URL=mysql://user:password@localhost:3306/hirex

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Login provider
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# LLM and platform API (used for job scoring and cover letters)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Stripe billing (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Server port (optional, defaults to 3000)
PORT=3000
